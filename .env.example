# Server (nur für lokalen Dev-Server, npm run dev — auf Netlify irrelevant)
PORT=3000
NODE_ENV=production

# Muss auf einen langen, zufälligen Wert gesetzt werden (z.B. `openssl rand -hex 32`).
# Dient zur Signierung der Login-Sitzungen (JWT-Cookie).
# WICHTIG: In den Netlify-Umgebungsvariablen (Site settings → Environment variables)
# denselben Wert hinterlegen, sonst werden Sitzungen bei jedem Deploy ungültig.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Datenbank ----
# Auf Netlify: Netlify DB aktivieren (Team-Dashboard → Extensions → Netlify DB, oder
# `netlify db init` per CLI). Netlify setzt dann automatisch NETLIFY_DATABASE_URL.
# Lokal: eigene Postgres-Verbindung (z.B. lokale Postgres-Instanz oder eine
# Neon-Dev-Datenbank) über DATABASE_URL angeben.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/vertriebsportal_dev

# ---- SMTP (Versand von Offerte & Rechnung per E-Mail) ----
# Ohne diese Angaben startet der Server trotzdem, E-Mails werden dann nur
# geloggt statt wirklich verschickt.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="vertriebsportal.ch <no-reply@vertriebsportal.ch>"

# Eure interne Adresse: erhält bei jeder neuen Registrierung und jeder neuen
# Bestellung automatisch eine eigene Benachrichtigungs-E-Mail. Optional, aber
# empfohlen — ohne diesen Wert bekommt ihr keine Benachrichtigungen.
COMPANY_NOTIFY_EMAIL=

# ---- Firmendaten für Offerte/Rechnung ----
COMPANY_NAME="Esche Consulting GmbH"
COMPANY_ADDRESS_LINE1="Städtle 35"
COMPANY_ADDRESS_LINE2="9490 Vaduz, Fürstentum Liechtenstein"
COMPANY_EMAIL=support@vertriebsportal.ch
COMPANY_PHONE=
COMPANY_UID=""
COMPANY_IBAN=""
COMPANY_MWST_RATE=8.1
COMPANY_PAYMENT_TERMS_DAYS=30
