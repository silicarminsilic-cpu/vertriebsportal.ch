# Server
PORT=3000
NODE_ENV=production

# Muss auf einen langen, zufälligen Wert gesetzt werden (z.B. `openssl rand -hex 32`).
# Dient zur Signierung der Login-Sitzungen (JWT-Cookie).
SESSION_SECRET=change-me-to-a-long-random-string

# Pfad zur SQLite-Datenbankdatei
DB_PATH=./data/app.db

# ---- SMTP (Versand von Offerte & Rechnung per E-Mail) ----
# Ohne diese Angaben startet der Server trotzdem, E-Mails werden dann nur
# geloggt statt wirklich verschickt.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="vertriebsportal.ch <no-reply@vertriebsportal.ch>"

# Optional: interne Adresse, die bei jeder neuen Bestellung eine Kopie (BCC) erhält
COMPANY_NOTIFY_EMAIL=

# ---- Firmendaten für Offerte/Rechnung ----
COMPANY_NAME="vertriebsportal.ch"
COMPANY_ADDRESS_LINE1="Musterstrasse 1"
COMPANY_ADDRESS_LINE2="8000 Zürich"
COMPANY_EMAIL=support@vertriebsportal.ch
COMPANY_PHONE=
COMPANY_UID="CHE-000.000.000 MWST"
COMPANY_IBAN="CH00 0000 0000 0000 0000 0"
COMPANY_MWST_RATE=8.1
COMPANY_PAYMENT_TERMS_DAYS=30
